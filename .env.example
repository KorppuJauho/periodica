# Same user/group qBittorrent runs as. Find them with:  docker exec qbittorrent id
PUID=1000
PGID=10
TZ=Etc/UTC
# Image tag: latest/stable (newest release), 1.0 (newest 1.0.x), 1.0.0 (exact), dev (testing only)
IMAGE_TAG=latest
# Folder containing both torrents/ and media/ (one mount, so hardlinks work)
DATA_PATH=/srv/data
# Persistent config/database folder, owned by PUID:PGID
CONFIG_PATH=/srv/docker/periodica/config
# LAN IP of the server to bind the web UI to (0.0.0.0 = all interfaces)
BIND_IP=0.0.0.0
PORT=8765
# true = offline mode: no qBittorrent, Jellyfin or scan API; Periodica only watches the source folder
OFFLINE_MODE=false
